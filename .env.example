# mock працює локально без ключа. apimart запускає реальні платні генерації.
PROVIDER_MODE=mock
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai
# Базовий HTTPS-origin без шляху: APIMart автоматично додає /callback.
# Залиште порожнім для polling. Тунель спрямовуйте лише на callback-порт.
WEBHOOK_BASE_URL=
# Публічний HTTPS-origin тунелю на localhost:3001 для локальних відео/аудіо.
# Працює незалежно від webhook: WEBHOOK_BASE_URL можна залишити порожнім.
MEDIA_BASE_URL=
CALLBACK_PORT=3001
PORT=3000
# Опублікований порт Vite у compose.dev.yaml; локальний npm dev використовує 5173.
WEB_PORT=5173
# Якщо порожньо, npm run dev запускає власну PostgreSQL. Compose задає адресу db.
DATABASE_URL=
STORAGE_DIR=./storage
# Початкові значення для нової бази; перезапуск не поповнює наявний баланс.
INITIAL_CREDITS=300
CREDITS_PER_SECOND=2.85
JOB_TIMEOUT_SECONDS=1200
PROVIDER_HTTP_TIMEOUT_SECONDS=30
WORKER_CONCURRENCY=2
WORKER_EMBEDDED=true
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
LOG_LEVEL=info
